# Copy to .env and adjust (optional; can export in shell instead).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite by default (USE_SQLITE=true or unset). For PostgreSQL:
#   USE_POSTGRES=1
#   docker compose up -d
POSTGRES_DB=fairdee
POSTGRES_USER=fairdee
POSTGRES_PASSWORD=fairdee
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# USE_POSTGRES=1
# USE_SQLITE=false
